# Clerk Authentication (get from https://clerk.com)
CLERK_SECRET_KEY="sk_test_your_clerk_secret_key_here"
# Optional: Clerk JWT public key for verification without a Clerk API request
# CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----..."
# Optional comma-separated dashboard origins, e.g. http://localhost:3000,https://your-site.com
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

# Backend Configuration
PORT=8080
NODE_ENV=development

# Persistence: set a PostgreSQL URL in production.
# Without DATABASE_URL, the backend stores data in backend/data/state.json.
# DATABASE_URL=postgresql://user:password@host:5432/vortix
# VORTIX_DATA_FILE=./data/state.json

# AI Configuration (Optional)
GROQ_API_KEY=your_groq_api_key_here

# Ollama Configuration (Local AI - Optional)
OLLAMA_URL=http://localhost:11434

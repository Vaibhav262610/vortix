{
  "name": "vortix",
  "version": "1.2.13",
  "description": "AI-powered remote OS control system with natural language commands, real-time monitoring, and modern web dashboard",
  "bin": {
    "vortix": "bin/vortix.js"
  },
  "scripts": {
    "prepack": "node scripts/sync-agent.js",
    "build:tray": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-tray.ps1",
    "build:installer": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-installer.ps1"
  },
  "keywords": [
    "ai",
    "automation",
    "remote-control",
    "cli",
    "os-control",
    "agent",
    "nodejs",
    "websocket",
    "command-execution",
    "screen-sharing",
    "file-transfer",
    "multi-device",
    "real-time-monitoring",
    "system-stats",
    "natural-language",
    "dashboard",
    "mobile-support",
    "cloud-backend",
    "multi-platform",
    "windows",
    "macos",
    "linux",
    "typescript",
    "nextjs",
    "react",
    "framer-motion"
  ],
  "author": "Vaibhav Rajpoot <vaibhavrajpoot2626@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vaibhav262610/vortix.git"
  },
  "homepage": "https://vortixai.vercel.app",
  "bugs": {
    "url": "https://github.com/Vaibhav262610/vortix/issues",
    "email": "vaibhavrajpoot2626@gmail.com"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "files": [
    "bin/vortix.js",
    "agent/agent.js",
    "agent/storage-scan.js",
    "agent/desktop-control.js",
    "tray/VortixTray.exe",
    "tray/VortixTray.cs",
    "tray/VortixTray.ico",
    "scripts/build-tray.ps1",
    "README.md"
  ],
  "dependencies": {
    "axios": "^1.6.0",
    "screenshot-desktop": "^1.15.8",
    "ws": "^8.22.1"
  }
}
